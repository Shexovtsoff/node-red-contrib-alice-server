# =====================================================================
# НАСТРОЙКИ СЕТИ И СЕРВЕРА
# =====================================================================
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=5000

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5001

LOG_LEVEL=INFO

# =====================================================================
# ХРАНИЛИЩЕ ДАННЫХ
# Для Docker: /data (монтируется как volume в docker-compose.yml)
# Для локального запуска: оставить пустым или указать путь к директории
# =====================================================================
DATA_DIR=/data
MAX_USER_TOKENS=5

# =====================================================================
# 1. OAUTH ПРИЛОЖЕНИЕ В ЯНДЕКСЕ (oauth.yandex.ru)
# Создайте приложение в oauth.yandex.ru:
#   - Платформы: Веб-сервисы
#   - Redirect URI: https://<ваш_домен_или_ip>:5000/yandex_callback
#   - Доступы: login:email, login:info, login:avatar
# =====================================================================
YANDEX_OAUTH_CLIENT_ID=your_yandex_oauth_client_id_here
YANDEX_OAUTH_SECRET=your_yandex_oauth_client_secret_here

# =====================================================================
# 2. СВЯЗКА АККАУНТОВ В ДИАЛОГАХ (dialogs.yandex.ru/developer)
# Настройки вкладки «Связка аккаунтов» в вашем приватном навыке:
#   - Идентификатор клиента (Client ID): любое произвольное значение
#   - Секрет клиента (Client Secret): любое произвольное секретное значение
#   - URL авторизации: https://<ваш_домен_или_ip>:5000/auth
#   - URL получения токена: https://<ваш_домен_или_ip>:5000/token
#   - URL обновления токена: https://<ваш_домен_или_ip>:5000/token
# =====================================================================
SMART_HOME_CLIENT_ID=your_smart_home_client_id
SMART_HOME_CLIENT_SECRET=your_smart_home_client_secret

# =====================================================================
# 3. CALLBACK-УВЕДОМЛЕНИЯ В ЯНДЕКС ДИАЛОГИ (dialogs.yandex.net)
#   - YANDEX_SKILLS_ID: Идентификатор диалога/навыка из URL в консоли разработчика
#   - YANDEX_SKILL_OAUTH_TOKEN: OAuth токен создателя навыка с правом dialogs:skills
#     (получается по инструкции Яндекса: https://yandex.ru/dev/dialogs/smart-home/doc/concepts/push-notifications.html)
# =====================================================================
YANDEX_SKILLS_ID=your_dialogs_skill_id
YANDEX_SKILL_OAUTH_TOKEN=OAuth y0_AgAAA...
